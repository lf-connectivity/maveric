# ==============================================================================
# Agentic Mobility - Environment Configuration
# ==============================================================================
# NOTE: This agent automatically searches for .env in parent directories
#       The ROOT .env file (AgenticMaveric/.env) will be used by default
#
# To use the shared root configuration:
#   1. Copy: cp ../../../.env.example ../../../.env
#   2. Edit: ../../../.env
#
# Or create a local .env here (will override root .env)
# ==============================================================================

RADP_SERVICE_IP=127.0.0.1
RADP_SERVICE_PORT=8080

# LLM Provider Selection
LLM_PROVIDER=groq  # Options: "groq" or "bedrock"

# Groq API Configuration (if using LLM_PROVIDER=groq)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.1-70b-versatile

# AWS Bedrock Configuration (if using LLM_PROVIDER=bedrock)
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1
# Optional: Specify AWS credentials (otherwise uses default AWS credentials from ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Geocoding Configuration
GEOCODING_CACHE_ENABLED=true
GEOCODING_CACHE_TTL=3600

# Retry Configuration
MAX_RETRY_ATTEMPTS=2
RETRY_TIMEOUT_SECONDS=30
